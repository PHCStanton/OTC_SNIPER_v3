# OTC Sniper VPS Data Agent Environment Configuration
# Copy to data-agent/.env (untracked) and fill secrets. Never commit the active .env.

# --- GCP ---
GCP_PROJECT_ID=otc-sniper-prod
# GOOGLE_APPLICATION_CREDENTIALS=data-agent/configs/your-service-account.json

# --- Pocket Option stream ---
# Leave empty or use demo_ssid_placeholder to keep collector in standby.
PO_SSID=42["auth",{"session":"YOUR_POCKET_OPTION_SSID_HERE","isDemo":1}]

# Comma-separated assets for initial WebSocket subscription.
# If unset, collector defaults to EURUSD_otc,GBPUSD_otc,USDJPY_otc.
TARGET_ASSETS=EURUSD_otc,GBPUSD_otc,USDJPY_otc,AUDCAD_otc,USDCHF_otc,ZARUSD_otc,NGNUSD_otc,USDARS_otc

# --- Telemetry / DaaS HTTP ---
TELEMETRY_PORT=8090
# Optional: timeout (seconds) for HTTP-thread → asyncio subscription gateway
SUBSCRIBE_TIMEOUT_SECONDS=10

# --- xAI / Hermes ---
XAI_API_KEY=your_xai_grok_api_key_here

# --- OpenWA WhatsApp gateway ---
# Canonical name used by OpenWABridge (default http://localhost:8080).
OPENWA_API_URL=http://localhost:8080
# Legacy alias (still accepted if OPENWA_API_URL is unset): OPENWA_SERVER_URL
OPENWA_RECIPIENT_PHONE=+1234567890
# OPENWA_API_KEY=
