FROM python:3.11-slim

WORKDIR /app

# Install system dependencies
RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential \
    && rm -rf /var/lib/apt/lists/*

# Copy requirements and install python packages
COPY data-agent/requirements.txt /app/data-agent/requirements.txt
RUN pip install --no-cache-dir -r /app/data-agent/requirements.txt

# Copy source repository
COPY . /app

ENV PYTHONPATH=/app
ENV TELEMETRY_PORT=8090

# Data-agent liveness only (stdlib urllib). Independent of OpenWA.
HEALTHCHECK --interval=15s --timeout=5s --start-period=40s --retries=3 \
  CMD python -c "import os,urllib.request; p=os.environ.get('TELEMETRY_PORT','8090'); urllib.request.urlopen(f'http://127.0.0.1:{p}/api/health/live', timeout=3)"

CMD ["python", "data-agent/src/vps_server.py"]
